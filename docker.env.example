# Copy values into your shell or a private env file. Never commit real credentials.
NEXT_PUBLIC_AGENT_URL=http://localhost:8765
NEXT_PUBLIC_CLOUD_API_URL=http://localhost:3000
NEXT_PUBLIC_USE_CLOUD_HARDWARE_BRIDGE=0
TRASH_SORTER_HOST_DATA_DIR=C:/Users/YourName/AppData/Roaming/TrashSorter
TRASH_SORTER_SUPABASE_DATABASE_URL=
TRASH_SORTER_AUTH_DATABASE_URL=
DATABASE_URL=
# Local/dev-only; keep 0 for production. When 1 and no explicit store exists,
# local auth can seed `admin/admin123` and `user/user123`.
TRASH_SORTER_AUTH_DEV_DEFAULTS=0
# Optional bootstrap admin for private deployments. Do not commit real values.
TRASH_SORTER_BOOTSTRAP_ADMIN_USERNAME=
TRASH_SORTER_BOOTSTRAP_ADMIN_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
TRASH_SORTER_CLIENT_REQUEST_CONCURRENCY=2
TRASH_SORTER_HARDWARE_REQUEST_CONCURRENCY=1
TRASH_SORTER_DB_QUEUE_CONCURRENCY=1
TRASH_SORTER_DB_LOCK_TIMEOUT_MS=2000
TRASH_SORTER_DB_STATEMENT_TIMEOUT_MS=15000
