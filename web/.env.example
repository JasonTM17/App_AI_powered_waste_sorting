NEXT_PUBLIC_AGENT_URL=http://localhost:8765
# Keep local hardware on the local agent by default. Set to 1 only when Vercel
# has a real TRASH_SORTER_HARDWARE_BRIDGE_URL tunnel and matching bridge secret.
NEXT_PUBLIC_USE_CLOUD_HARDWARE_BRIDGE=0
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Web login uses local agent session tokens stored at runtime.
# Legacy NEXT_PUBLIC_AGENT_TOKEN is intentionally not used by the login UI.

# Server-side only. Local FastAPI and deployed Next.js chat both read these values.
# Put them in ../.env.local for local use and in Vercel Production for cloud chat.
# Never expose DEEPSEEK_API_KEY as NEXT_PUBLIC_*.
TRASH_SORTER_AUTH_DEV_DEFAULTS=1
TRASH_SORTER_AUTH_DATABASE_URL=postgresql://trash_user:strong-password@localhost:5432/trash_sorter
DATABASE_URL=postgresql://trash_user:strong-password@localhost:5432/trash_sorter
TRASH_SORTER_AUTH_DB=
TRASH_SORTER_BOOTSTRAP_ADMIN_USERNAME=owner
TRASH_SORTER_BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production
TRASH_SORTER_SESSION_HOURS=12
TRASH_SORTER_ALLOWED_ORIGINS=http://localhost:3000
TRASH_SORTER_HARDWARE_BRIDGE_URL=https://your-tunnel.example.com
TRASH_SORTER_HARDWARE_BRIDGE_SECRET=generate-a-long-random-secret
# Server-side only. Vercel Cron adds this value to the Authorization header.
CRON_SECRET=generate-a-different-long-random-secret
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Backend locks DeepSeek to deepseek-v4-flash. Keep this value for test compatibility.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=75
